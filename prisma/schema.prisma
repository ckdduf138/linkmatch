generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Room {
  id        String   @id @default(cuid())
  title     String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  // 동결 보존된 공개방. 만료돼도 지우지 않고 읽기 전용 아카이브로 남긴다.
  frozenAt  DateTime?

  questions Question[]
  participants Participant[]

  @@index([isPublic, expiresAt])
  @@index([isPublic, createdAt])
  @@index([frozenAt])
}

model Question {
  id       String @id @default(cuid())
  roomId   String
  type     String // "balance" | "multiple" | "subjective"
  title    String
  optionA  String? // balance game option A
  optionB  String? // balance game option B
  options  String? // JSON array for multiple choice options
  order    Int
  // POPULAR_QUESTIONS의 id. 방을 만들 때 문항 텍스트만 복사되면 "이 질문이 실제로
  // 몇 명한테 답을 받았나"를 영영 계산할 수 없다. 사용자가 직접 쓴 질문은 null.
  sourceId String?

  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([roomId])
  @@index([sourceId])
}

model Participant {
  id        String   @id @default(cuid())
  roomId    String
  nickname  String
  createdAt DateTime @default(now())

  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([roomId])
}

model Answer {
  id            String @id @default(cuid())
  questionId    String
  participantId String
  value         String // "A" | "B" for balance, option index for multiple, free text for subjective

  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([questionId, participantId])
  @@index([questionId])
  @@index([participantId])
}
